{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "src/**/*", "shared/**/*"],
  "exclude": ["dist", "server", "functions", "workers", "tests"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true
  }
}
