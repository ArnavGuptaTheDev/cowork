---
import Base from '../layouts/Base.astro';
import { icons } from '../components/icons';
import { copy } from '../content/copy';
---

<Base title={copy.appName}>
  <main class="hero" id="main">
    <div class="wordmark" aria-hidden="true">
      <svg class="knot" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" set:html={icons.knot} />
      {copy.appName}
    </div>
    <h1 set:html={copy.landing.title} />
    <p class="lede">{copy.landing.lede}</p>
    <p class="notice" id="signin-error" role="alert" hidden></p>
    <div>
      <a class="btn google-btn block" id="signin" href="/api/auth/google/start">
        <svg viewBox="0 0 24 24" aria-hidden="true" width="20" height="20">
          <path fill="#4285F4" d="M23.5 12.3c0-.8-.1-1.6-.2-2.3H12v4.5h6.5a5.6 5.6 0 01-2.4 3.6v3h3.9c2.3-2.1 3.5-5.2 3.5-8.8z"></path>
          <path fill="#34A853" d="M12 24c3.2 0 6-1.1 8-2.9l-3.9-3c-1.1.7-2.5 1.2-4.1 1.2-3.1 0-5.8-2.1-6.7-5H1.3v3.1A12 12 0 0012 24z"></path>
          <path fill="#FBBC05" d="M5.3 14.3a7.2 7.2 0 010-4.6V6.6h-4a12 12 0 000 10.8z"></path>
          <path fill="#EA4335" d="M12 4.8c1.8 0 3.3.6 4.6 1.8l3.4-3.4A12 12 0 001.3 6.6l4 3.1c.9-2.8 3.6-4.9 6.7-4.9z"></path>
        </svg>
        {copy.landing.signIn}
      </a>
      <p class="faint mt-4">{copy.landing.inviteOnly}</p>
      <p class="faint legal-links mt-2"><a href="/privacy">Privacy policy</a></p>
    </div>
  </main>
  <script>
    import { copy } from '../content/copy';
    const params = new URLSearchParams(location.search);
    const next = params.get('next');
    const link = document.getElementById('signin') as HTMLAnchorElement | null;
    if (link && next && next.startsWith('/') && !next.startsWith('//')) {
      link.href = `/api/auth/google/start?next=${encodeURIComponent(next)}`;
    }
    const err = params.get('error');
    const box = document.getElementById('signin-error');
    if (err && box) {
      box.textContent = copy.landing.errors[err] ?? 'Sign-in failed. Please try again.';
      box.hidden = false;
    }
    // Already signed in? Skip the landing page.
    fetch('/api/me', { credentials: 'same-origin' })
      .then((r) => {
        if (r.ok) location.replace(next && next.startsWith('/') && !next.startsWith('//') ? next : '/today');
      })
      .catch(() => undefined);
  </script>
</Base>
